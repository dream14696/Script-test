			renderLines(entry.lines)
			showView("console")
		end)
	end
end

local function setCurrent(entry)
	if current and current.kind == "info" and not current.saved and current ~= entry then
		current.saved = true
		table.insert(history, 1, current)
		if #history > 100 then table.remove(history) end
		refreshHistoryButton()
	end
	current = entry
	renderLines(entry.lines)
	showView("console")
end

HistoryBtn.MouseButton1Click:Connect(function()
	if HistoryScroll.Visible then
		showView("console")
	else
		renderHistory()
		showView("history")
	end
end)

