local sel = nil

local function isOverMine(pos)
	local inset = GuiService:GetGuiInset()
	local raw = pos + inset
	local function inside(gui)
		if not gui.Visible then return false end
		local p, sz = gui.AbsolutePosition, gui.AbsoluteSize
		return raw.X >= p.X and raw.X <= p.X + sz.X and raw.Y >= p.Y and raw.Y <= p.Y + sz.Y
	end
	return inside(Main) or inside(Dots) or inside(Popup) or inside(NameLabel)
end

clearSelection = function()
	if sel then
		for _, c in ipairs(sel.conns) do c:Disconnect() end
	end
	sel = nil
	Highlight3D.Adornee = nil
	EspBox.Visible = false
	Dots.Visible = false
	NameLabel.Visible = false
	Popup.Visible = false
end

local function stamp()
	return os.date("%d/%m/%Y %H:%M:%S")
end

local function selectInstance(inst, kind, hitPos)
	if sel and sel.inst == inst then return end
	clearSelection()

	local s = {
		inst = inst,
		kind = kind,
		hitPos = hitPos,
		conns = {},
		selectedAt = stamp(),
		count = 0,
	}
	local function noteChange(name)
		s.count = s.count + 1
		s.lastName = name
		s.lastTime = stamp()
	end
	table.insert(s.conns, inst.Changed:Connect(function(prop) noteChange(tostring(prop)) end))
	table.insert(s.conns, inst.ChildAdded:Connect(function(c) noteChange("ChildAdded (" .. c.Name .. ")") end))
	table.insert(s.conns, inst.ChildRemoved:Connect(function(c) noteChange("ChildRemoved (" .. c.Name .. ")") end))
	sel = s

	if kind == "obj" and inst:IsA("BasePart") and not inst:IsA("Terrain") then
		Highlight3D.Adornee = inst
	end

	NameLabel.Text = inst.Name .. "  [" .. inst.ClassName .. "]"
	Dots.Visible = true
	NameLabel.Visible = true
	EspBox.Visible = kind == "gui"
	updateStatus()
end

local function topGuiObjectAt(pos)
	local pg = Player:FindFirstChildOfClass("PlayerGui")
	local sources = {}
	if pg then table.insert(sources, pg) end
	local ok, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok and cg then table.insert(sources, cg) end

	for _, src in ipairs(sources) do
		local okc, list = pcall(function() return src:GetGuiObjectsAtPosition(pos.X, pos.Y) end)
		if okc and list then
			for _, g in ipairs(list) do
				if not g:IsDescendantOf(Root) then
					return g
				end
			end
		end
	end
	return nil
end

local function handleTap(pos, processedAtStart)
	if not mode then return end
	if isOverMine(pos) then return end

	if mode == "obj" then
		if processedAtStart then return end
		local cam = workspace.CurrentCamera or Camera
		local ray = cam:ScreenPointToRay(pos.X, pos.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { Player.Character }
		local res = workspace:Raycast(ray.Origin, ray.Direction * 3000, params)
		if res and res.Instance then
			selectInstance(res.Instance, "obj", res.Position)
		else
			clearSelection()
		end
	else
		local g = topGuiObjectAt(pos)
		if g then
			selectInstance(g, "gui")
		else
			clearSelection()
		end
	end
end

local tapInput, tapPos, tapTime, tapProcessed

track(UserInputService.InputBegan:Connect(function(input, processed)
	if not isPointer(input) then return end
	if tapInput then return end
	tapInput = input
	tapPos = Vector2.new(input.Position.X, input.Position.Y)
	tapTime = os.clock()
	tapProcessed = processed
end))

track(UserInputService.InputEnded:Connect(function(input)
	if not tapInput then return end
	local same = input == tapInput
		or (input.UserInputType == Enum.UserInputType.MouseButton1 and tapInput.UserInputType == Enum.UserInputType.MouseButton1)
	if not same then return end

	local startPos2, started, processed = tapPos, tapTime, tapProcessed
	tapInput = nil

	local endPos = Vector2.new(input.Position.X, input.Position.Y)
	if (endPos - startPos2).Magnitude < 12 and (os.clock() - started) < 0.7 then
		handleTap(startPos2, processed)
	end
end))

