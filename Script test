-- OCULTAR / RESTAURAR OBJETOS
--------------------------------------------------

local hidden = {}

local function hiddenCount()
	local n = 0
	for _ in pairs(hidden) do n = n + 1 end
	return n
end

local function setProp(records, inst, prop, value)
	local ok, old = pcall(function() return inst[prop] end)
	if ok then
		table.insert(records, { inst, prop, old })
		pcall(function() inst[prop] = value end)
	end
end

local function hideObject(obj)
	if hidden[obj] then return true end
	local rec = {}

	if obj:IsA("Terrain") then
		return false, "El terreno no se puede ocultar."
	elseif obj:IsA("BasePart") then
		setProp(rec, obj, "Transparency", 1)
		setProp(rec, obj, "CanCollide", false)
		setProp(rec, obj, "CanTouch", false)
		for _, d in ipairs(obj:GetDescendants()) do
			if d:IsA("Decal") or d:IsA("Texture") then
				setProp(rec, d, "Transparency", 1)
			elseif d:IsA("SurfaceGui") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail")
				or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") or d:IsA("Light") then
				setProp(rec, d, "Enabled", false)
			end
		end
	elseif obj:IsA("GuiObject") then
		setProp(rec, obj, "Visible", false)
	else
		return false, "Este tipo de objeto no se puede ocultar."
	end

	hidden[obj] = rec
	return true
end

local function showObject(obj)
	local rec = hidden[obj]
	if not rec then return end
	for i = #rec, 1, -1 do
		local r = rec[i]
		pcall(function() r[1][r[2]] = r[3] end)
	end
	hidden[obj] = nil
end

local function restoreAll()
	local list = {}
	for obj in pairs(hidden) do table.insert(list, obj) end
	for _, obj in ipairs(list) do showObject(obj) end
end

