track(RunService.RenderStepped:Connect(function()
	if not sel then return end
	local inst = sel.inst
	if not inst.Parent then
		clearSelection()
		updateStatus()
		return
	end

	local cam = workspace.CurrentCamera or Camera
	local vp = cam.ViewportSize
	local px, py, visible

	if sel.kind == "obj" then
		local worldPos
		if inst:IsA("BasePart") and not inst:IsA("Terrain") then
			worldPos = inst.Position + Vector3.new(0, inst.Size.Y / 2 + 1.2, 0)
		else
			worldPos = (sel.hitPos or Vector3.zero) + Vector3.new(0, 3, 0)
		end
		local v, onScreen = cam:WorldToViewportPoint(worldPos)
		visible = onScreen and v.Z > 0
		px, py = v.X, v.Y
	else
		local ap, asz = inst.AbsolutePosition, inst.AbsoluteSize
		EspBox.Position = UDim2.fromOffset(ap.X, ap.Y)
		EspBox.Size = UDim2.fromOffset(asz.X, asz.Y)
		px = ap.X + asz.X / 2
		py = ap.Y - 4
		visible = true
	end

	Dots.Visible = visible
	NameLabel.Visible = visible
	if not visible then
		Popup.Visible = false
		return
	end

	px = math.clamp(px, 20, vp.X - 20)
	py = math.clamp(py, 52, vp.Y - 10)
	Dots.Position = UDim2.fromOffset(px, py)
	NameLabel.Position = UDim2.fromOffset(math.min(px + 20, vp.X - 160), py)

	if Popup.Visible then
		Popup.Position = UDim2.fromOffset(math.clamp(px, 110, vp.X - 110), math.min(py + 8, vp.Y - 100))
	end
end))

