local function r(n, d)
	local m = 10 ^ (d or 2)
	return math.floor(n * m + 0.5) / m
end

local function fmt(v)
	local t = typeof(v)
	if t == "nil" then return "nil"
	elseif t == "boolean" then return v and "Sí" or "No"
	elseif t == "number" then return tostring(r(v, 3))
	elseif t == "string" then
		if v == "" then return "(vacío)" end
		if #v > 140 then v = v:sub(1, 140) .. "…" end
		return v
	elseif t == "Vector3" then return string.format("%.2f, %.2f, %.2f", v.X, v.Y, v.Z)
	elseif t == "Vector2" then return string.format("%.2f, %.2f", v.X, v.Y)
	elseif t == "CFrame" then
		local rx, ry, rz = v:ToOrientation()
		return string.format("pos(%.2f, %.2f, %.2f) rot(%.1f°, %.1f°, %.1f°)", v.X, v.Y, v.Z, math.deg(rx), math.deg(ry), math.deg(rz))
	elseif t == "Color3" then
		return string.format("RGB(%d, %d, %d)  #%s", math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5), v:ToHex())
	elseif t == "BrickColor" then return v.Name
	elseif t == "UDim2" then return string.format("{%.2f, %d}, {%.2f, %d}", v.X.Scale, math.floor(v.X.Offset), v.Y.Scale, math.floor(v.Y.Offset))
	elseif t == "UDim" then return string.format("{%.2f, %d}", v.Scale, math.floor(v.Offset))
	elseif t == "EnumItem" then return (tostring(v):gsub("^Enum%.", ""))
	elseif t == "Instance" then return v.Name .. " [" .. v.ClassName .. "]"
	elseif t == "NumberRange" then return v.Min .. " - " .. v.Max
	else return tostring(v) end
end

local function describe(inst)
	if not inst then return "nil" end
	return inst.Name .. " [" .. inst.ClassName .. "]"
end

local function collectInfo(obj, s)
	local L = {}
	local function H(t) L[#L + 1] = { h = t } end
	local function K(k, v) L[#L + 1] = { k = tostring(k), v = fmt(v) } end
	local function P(label, prop)
		local ok, v = pcall(function() return obj[prop] end)
		if ok then K(label, v) end
	end
	local function safe(fn, default)
		local ok, v = pcall(fn)
		if ok then return v end
		return default
	end

	H("General")
	K("Nombre", obj.Name)
	K("Clase (tipo)", obj.ClassName)
	K("Ruta completa", safe(function() return obj:GetFullName() end, "?"))
	K("Padre", describe(obj.Parent))
	K("Padre del padre", describe(obj.Parent and obj.Parent.Parent))
	K("Contenedor raíz", safe(function()
		local a = obj
		while a.Parent and a.Parent ~= game do a = a.Parent end
		return describe(a)
	end, "?"))
	K("Profundidad en el árbol", safe(function()
		local n, a = 0, obj
		while a.Parent do n = n + 1 a = a.Parent end
		return n
	end, "?"))
	K("Hijos directos", #obj:GetChildren())
	K("Descendientes totales", safe(function() return #obj:GetDescendants() end, "?"))
	K("Hermanos (mismo padre)", safe(function() return #obj.Parent:GetChildren() - 1 end, "?"))
	K("Archivable", obj.Archivable)
	K("ID de depuración", safe(function() return obj:GetDebugId() end, "no disponible"))
	K("Es BasePart", obj:IsA("BasePart"))
	K("Es Model", obj:IsA("Model"))
	K("Es GuiObject", obj:IsA("GuiObject"))

	H("Modificaciones (desde que lo seleccionaste)")
	K("Seleccionado el", s.selectedAt)
	K("Fecha de la última modificación", s.lastTime or "sin cambios detectados")
	K("Nombre de la última modificación", s.lastName or "ninguna")
	K("Modificaciones detectadas", s.count)

	H("Etiquetas y atributos")
	local tags = safe(function() return CollectionService:GetTags(obj) end, {})
	K("Etiquetas (tags)", #tags > 0 and table.concat(tags, ", ") or "ninguna")
	local attrs = safe(function() return obj:GetAttributes() end, {})
	local ac = 0
	for name, value in pairs(attrs) do
		ac = ac + 1
		K("Atributo " .. name, value)
	end
	if ac == 0 then K("Atributos", "ninguno") end

	if obj:IsA("BasePart") then
		H("Posición y física")
		P("Posición", "Position")
		P("Orientación (°)", "Orientation")
		P("Tamaño", "Size")
		K("Volumen aproximado", r(obj.Size.X * obj.Size.Y * obj.Size.Z))
		P("CFrame", "CFrame")
		P("Anclado", "Anchored")
		P("CanCollide (colisión)", "CanCollide")
		P("CanTouch", "CanTouch")
		P("CanQuery", "CanQuery")
		P("Masa", "Mass")
		P("Massless", "Massless")
		P("Velocidad lineal", "AssemblyLinearVelocity")
		P("Velocidad angular", "AssemblyAngularVelocity")
		P("Grupo de colisión", "CollisionGroup")
		P("Propiedades físicas", "CustomPhysicalProperties")
		if not obj.Anchored then
			K("Dueño de red", safe(function()
				local o = obj:GetNetworkOwner()
				return o and o.Name or "Servidor"
			end, "?"))
		end
		K("Distancia a tu personaje", safe(function()
			local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
			return hrp and (hrp.Position - obj.Position).Magnitude or "?"
		end, "?"))
		K("Piezas unidas (assembly)", safe(function() return #obj:GetConnectedParts(true) end, "?"))

		H("Apariencia")
		P("Color", "Color")
		P("BrickColor", "BrickColor")
		P("Material", "Material")
		P("Variante de material", "MaterialVariant")
		P("Transparencia", "Transparency")
		P("Reflectancia", "Reflectance")
		P("Proyecta sombra", "CastShadow")
		P("Bloqueado (Locked)", "Locked")
		if obj:IsA("Part") then P("Forma", "Shape") end
		if obj:IsA("MeshPart") then
			P("MeshId", "MeshId")
			P("TextureID", "TextureID")
			P("Fidelidad de render", "RenderFidelity")
			P("Fidelidad de colisión", "CollisionFidelity")
		end
		if obj:IsA("UnionOperation") then
			P("Usa color de la pieza", "UsePartColor")
			P("Fidelidad de colisión", "CollisionFidelity")
		end
		if obj:IsA("SpawnLocation") then
			P("Neutral", "Neutral")
			P("Duración", "Duration")
		end
		if obj:IsA("Seat") or obj:IsA("VehicleSeat") then
			P("Ocupante", "Occupant")
			P("Desactivado", "Disabled")
		end
	end

	if obj:IsA("Model") then
		H("Modelo")
		P("Parte principal", "PrimaryPart")
		P("Pivote del mundo", "WorldPivot")
		P("Modo de streaming", "ModelStreamingMode")
		local ok, cf, size = pcall(function() return obj:GetBoundingBox() end)
		if ok then
			K("Centro del modelo", cf.Position)
			K("Tamaño del modelo", size)
		end
		K("Partes dentro", safe(function()
			local n = 0
			for _, d in ipairs(obj:GetDescendants()) do if d:IsA("BasePart") then n = n + 1 end end
			return n
		end, "?"))
	end

	if obj:IsA("GuiObject") then
		H("Interfaz (GuiObject)")
		P("Visible", "Visible")
