local function esc(s)
	s = tostring(s)
	s = s:gsub("&", "&amp;")
	s = s:gsub("<", "&lt;")
	s = s:gsub(">", "&gt;")
	return s
end

local function clearRows(scroll)
	for _, c in ipairs(scroll:GetChildren()) do
		if not c:IsA("UIListLayout") then c:Destroy() end
	end
end

local function renderLines(lines)
	clearRows(ConsoleScroll)
	for i, line in ipairs(lines) do
		local row = new("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = line.h and Color3.fromRGB(0, 70, 150) or Color3.fromRGB(20, 30, 48),
			BackgroundTransparency = line.h and 0.7 or (i % 2 == 0 and 0.88 or 1),
			BorderSizePixel = 0,
			LayoutOrder = i,
			ZIndex = 5,
		}, ConsoleScroll)

		new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 1),
			Size = UDim2.fromOffset(30, 16),
			Text = tostring(i),
			Font = Enum.Font.Code,
			TextSize = 11,
			TextColor3 = Color3.fromRGB(90, 115, 150),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 6,
		}, row)

		new("Frame", {
			Position = UDim2.fromOffset(35, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = BLUE,
			BackgroundTransparency = 0.5,
			BorderSizePixel = 0,
			ZIndex = 6,
		}, row)

		local text
		if line.h then
			text = '<b><font color="#4db2ff">── ' .. esc(line.h) .. " ──</font></b>"
		elseif line.k then
			text = '<font color="#7fb8ff">' .. esc(line.k) .. '</font><font color="#7a8599"> : </font>' .. esc(line.v)
		else
			text = '<font color="#8a93a5">' .. esc(line.t or "") .. "</font>"
		end

		new("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(42, 1),
			Size = UDim2.new(1, -46, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = text,
			RichText = true,
			Font = Enum.Font.Code,
			TextSize = 12,
			TextColor3 = Color3.fromRGB(225, 232, 245),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextWrapped = true,
			ZIndex = 6,
		}, row)

		new("UIPadding", { PaddingBottom = UDim.new(0, 2) }, row)
	end
	ConsoleScroll.CanvasPosition = Vector2.zero
end

