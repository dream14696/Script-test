		P("Tamaño en pantalla", "AbsoluteSize")
		P("Rotación", "Rotation")
		P("Punto de anclaje", "AnchorPoint")
		P("ZIndex", "ZIndex")
		P("Orden en el layout", "LayoutOrder")
		P("Activo (Active)", "Active")
		P("Seleccionable", "Selectable")
		P("Recorta hijos", "ClipsDescendants")
		P("Tamaño automático", "AutomaticSize")
		P("Restricción de tamaño", "SizeConstraint")
		P("Color de fondo", "BackgroundColor3")
		P("Transparencia de fondo", "BackgroundTransparency")
		P("Grosor del borde", "BorderSizePixel")
		K("ScreenGui contenedor", safe(function()
			local g = obj:FindFirstAncestorOfClass("ScreenGui")
			return g and describe(g) or "ninguno"
		end, "?"))
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			P("Texto", "Text")
			P("Fuente", "Font")
			P("Tamaño del texto", "TextSize")
			P("Color del texto", "TextColor3")
			P("Texto con saltos (wrap)", "TextWrapped")
			P("RichText", "RichText")
		end
		if obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
			P("Imagen", "Image")
			P("Color de imagen", "ImageColor3")
			P("Transparencia de imagen", "ImageTransparency")
			P("Escala de imagen", "ScaleType")
		end
		if obj:IsA("ScrollingFrame") then
			P("Tamaño del canvas", "CanvasSize")
			P("Posición del canvas", "CanvasPosition")
		end
	end

	if obj:IsA("ScreenGui") then
		H("ScreenGui")
		P("Habilitada", "Enabled")
		P("DisplayOrder", "DisplayOrder")
		P("Reiniciar al reaparecer", "ResetOnSpawn")
		P("Ignora el inset", "IgnoreGuiInset")
	end

	if obj:IsA("Humanoid") then
		H("Humanoid")
		P("Vida", "Health")
		P("Vida máxima", "MaxHealth")
		P("Velocidad al caminar", "WalkSpeed")
		P("Fuerza de salto", "JumpPower")
		P("Altura de salto", "JumpHeight")
		P("Altura de cadera", "HipHeight")
		P("Tipo de rig", "RigType")
		P("Nombre visible", "DisplayName")
		P("Material del suelo", "FloorMaterial")
	end

	if obj:IsA("Sound") then
		H("Sonido")
		P("SoundId", "SoundId")
		P("Volumen", "Volume")
		P("Reproduciendo", "Playing")
		P("Posición de tiempo", "TimePosition")
		P("Duración", "TimeLength")
		P("En bucle", "Looped")
	end

	if obj:IsA("Light") then
		H("Luz")
		P("Brillo", "Brightness")
		P("Color", "Color")
		P("Habilitada", "Enabled")
		P("Sombras", "Shadows")
		if obj:IsA("PointLight") or obj:IsA("SpotLight") then P("Rango", "Range") end
	end

	if obj:IsA("Decal") or obj:IsA("Texture") then
		H("Calcomanía / Textura")
		P("Textura", "Texture")
		P("Cara", "Face")
		P("Transparencia", "Transparency")
		P("Color", "Color3")
	end

	if obj:IsA("ProximityPrompt") then
		H("ProximityPrompt")
		P("Texto de acción", "ActionText")
		P("Texto del objeto", "ObjectText")
		P("Tiempo de pulsación", "HoldDuration")
		P("Distancia máxima", "MaxActivationDistance")
		P("Tecla", "KeyboardKeyCode")
		P("Habilitado", "Enabled")
	end

	if obj:IsA("ClickDetector") then
		H("ClickDetector")
		P("Distancia máxima", "MaxActivationDistance")
	end

	if obj:IsA("ValueBase") then
		H("Valor")
		P("Valor", "Value")
	end

	if obj:IsA("LuaSourceContainer") then
		H("Script")
		P("Deshabilitado", "Disabled")
		P("Contexto de ejecución", "RunContext")
	end

	if obj:IsA("Tool") then
		H("Herramienta")
		P("Puede soltarse", "CanBeDropped")
		P("Requiere mango", "RequiresHandle")
		P("Habilitada", "Enabled")
		P("Tooltip", "ToolTip")
	end

	if obj:IsA("ParticleEmitter") then
		H("Partículas")
		P("Habilitado", "Enabled")
		P("Tasa", "Rate")
		P("Vida", "Lifetime")
		P("Textura", "Texture")
	end

	if obj:IsA("Attachment") then
		H("Attachment")
		P("Posición local", "Position")
		P("Posición en el mundo", "WorldPosition")
	end

	if obj:IsA("JointInstance") or obj:IsA("Constraint") then
		H("Unión / Restricción")
		P("Part0", "Part0")
		P("Part1", "Part1")
		P("Habilitada", "Enabled")
	end

	local children = obj:GetChildren()
	H("Hijos (primeros 15)")
	if #children == 0 then
		K("Hijos", "ninguno")
	else
		for i, c in ipairs(children) do
			if i > 15 then
				K("…", "y " .. (#children - 15) .. " más")
				break
			end
			K(i, describe(c))
		end
	end

	H("Jerarquía (de dentro hacia fuera)")
	local a, depth = obj.Parent, 0
	while a and depth < 12 do
		depth = depth + 1
		K(depth, describe(a))
		a = a.Parent
	end

	return L
end

